{
  "name": "@hyprgate/napp-napplet-deployer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "paja": "kehto paja --target-url http://localhost:9540 -- pnpm vite --host 127.0.0.1",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "conformance": "pnpm build && napplet-conformance dist",
    "test:conformance": "pnpm conformance"
  },
  "dependencies": {
    "@hyprgate/types": "workspace:*",
    "@hyprgate/utils": "workspace:*",
    "@napplet/sdk": "0.24.1",
    "@napplet/shim": "0.26.1",
    "nostr-tools": "2.23.3",
    "svelte": "^5.54.1"
  },
  "devDependencies": {
    "@kehto/cli": "^0.2.9",
    "@napplet/conformance": "^0.12.0",
    "@napplet/conformance-cli": "^0.2.13",
    "@napplet/vite-plugin": "0.10.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
}
